          "heat_load_scale": 1.5,
          "max_failures": 3,
          "priority_assignment": "skewed",
          "slack_budget_pct": 0.45
        }
      ]
    },
    {
      "$comment_block": "Reconfiguration ranking.  simbench_lv_reconfig has multiple alternative paths so the path-ranking flag has alternatives to choose between; without alternative paths the flag is a no-op.",
      "name": "ablation_reconfig",
      "grids": [
        "simbench_lv_reconfig"
