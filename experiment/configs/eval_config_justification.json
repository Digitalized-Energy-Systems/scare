        {
          "enable_qv_auction_coordination": true
        },
        {
          "enable_qv_auction_coordination": true,
          "enable_qv_feeder_gate": false
        },
        {
          "enable_curtail_auction_gating": true
        },
        {
          "enable_curtail_auction_targeting": true
        }
      ],
      "scenarios": [
        {
          "kind": "pv_peak",
          "max_failures": 1,
          "priority_assignment": "skewed"
        }
