{
  "$comment": [
    "End-to-end validation of Route A (supply-priority holon ADMM).",
    "Two cells on cp_heavy + line_stress + multi-failure:",
    "  - mode=demand: Package C baseline (priority weights inert per the earlier finding)",
    "  - mode=supply: new Route A formulation, supply scarcity arbitrates priority",
    "Same scenario as priority_admm_targeted but reduced stress so",
    "the run doesn't get stuck in LP-infeasibility loops:",
    "  - load_scale=1.6, ampacity_scale=0.5 (less aggressive)",
    "  - failure_lambda=2.5, max_failures=5",
    "  - 30s sim",
    "Expected: mode=supply should produce service_fraction[tier-2] >",
    "service_fraction[tier-8] when scarcity binds."
  ],
  "name": "route_a_eval",
  "out_root": "experiment/_runs/eval",
  "simulation_duration_s": 30.0,
  "task_timeout_s": 1500.0,
  "failure_delay_s_max": 2.0,
  "write_timeseries": false,
  "timestamp_dir": true,
  "defaults": {
    "runs_per_grid": 1,
    "failure_lambda": 2.5,
    "max_failures": 5
  },
  "experiments": [
    {
      "name": "route_a",
      "grids": ["simbench_lv_cp_heavy"],
      "n_seeds": 1,
      "variants": ["scare"],
      "ablations": [
        {
          "community_partition_method": "modularity",
          "enable_tier_stratified_holon_admm": true,
          "holon_admm_mode": "demand",
          "hebbian_warmup_s": 4.0
        },
        {
          "community_partition_method": "modularity",
          "enable_tier_stratified_holon_admm": true,
          "holon_admm_mode": "supply",
          "hebbian_warmup_s": 4.0
        }
      ],
      "scenarios": [
        {
          "kind": "line_stress",
          "load_scale": 1.6,
          "ampacity_scale": 0.5,
          "slack_budget_pct": 0.45,
          "priority_assignment": "uniform"
        }
      ]
    }
  ]
}
