{
  "$comment": [
    "Smoke variant of eval_full \u2014 every experiment / scenario combination at",
    "n_seeds=1 so we get through every test case once without paying the full",
    "campaign's wallclock cost.  Used to validate the full eval pipeline end-to-end:",
    "every grid, every scenario kind, every variant, every ablation, and every",
    "sweep is exercised at least once.  When this passes cleanly, eval_full.json",
    "with its full seed counts is safe to submit to SLURM."
  ],
  "name": "eval_full_smoke",
  "out_root": "experiment/_runs/eval",
  "simulation_duration_s": 10.0,
  "task_timeout_s": 1500.0,
  "failure_delay_s_max": 1.0,
  "write_timeseries": true,
  "timestamp_dir": true,
  "defaults": {
    "runs_per_grid": 1,
    "failure_lambda": 1.5,
    "max_failures": 4
  },
