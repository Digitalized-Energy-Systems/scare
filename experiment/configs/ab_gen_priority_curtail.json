{
  "$comment": "A/B for generation-prioritised over-voltage relief. Arm B (default {}) = enable_generation_priority_curtailment TRUE: over-voltage auction curtails generators, excludes load-shed. Arm A ({enable_generation_priority_curtailment:false}) = legacy willingness auction that sheds load to 'fix' over-voltage. Paired deterministic seeds, same binary, config toggle. LV-S clean is the dominant paired gap; LV-S pv_peak exercises the export/over-voltage race; line_stress (import-driven, LV-50) is the no-regression guard (load-shed stays the correct lever there).",
  "name": "ab_gen_priority_curtail",
  "out_root": "experiment/_runs/eval",
  "simulation_duration_s": 30.0,
  "task_timeout_s": 1200.0,
  "failure_delay_s_max": 2.0,
  "write_timeseries": false,
  "write_trajectories": false,
  "timestamp_dir": true,
  "defaults": { "runs_per_grid": 16, "failure_lambda": 1.0, "max_failures": 3 },
  "experiments": [
    {
      "name": "lvs_clean_ab",
      "grids": ["simbench_lv_small"],
      "n_seeds": 16,
      "variants": ["scare"],
      "ablations": [ {}, { "enable_generation_priority_curtailment": false } ],
      "scenarios": [
        { "kind": "clean", "max_failures": 3, "priority_assignment": "skewed", "slack_budget_pct": 0.45 }
      ]
    },
    {
      "name": "lvs_clean_oracle",
      "grids": ["simbench_lv_small"],
      "n_seeds": 16,
      "variants": ["oracle"],
      "ablations": [ {} ],
      "scenarios": [
        { "kind": "clean", "max_failures": 3, "priority_assignment": "skewed", "slack_budget_pct": 0.45 }
      ]
    },
    {
      "name": "lvs_pv_ab",
      "grids": ["simbench_lv_small"],
      "n_seeds": 16,
      "variants": ["scare"],
      "ablations": [ {}, { "enable_generation_priority_curtailment": false } ],
      "scenarios": [
        { "kind": "pv_peak", "max_failures": 1, "priority_assignment": "skewed" }
      ]
    },
    {
      "name": "line_stress_ab",
      "grids": ["simbench_lv"],
      "n_seeds": 12,
      "variants": ["scare"],
      "ablations": [ {}, { "enable_generation_priority_curtailment": false } ],
      "scenarios": [
        { "kind": "line_stress", "load_scale": 1.8, "ampacity_scale": 0.5, "max_failures": 2, "priority_assignment": "skewed", "slack_budget_pct": 0.45 }
      ]
    }
  ],
  "slurm": { "partition": "rosa_express.p", "time": "02:00:00", "mem": "16G", "cpus": 1, "max_concurrent": 64 }
}
