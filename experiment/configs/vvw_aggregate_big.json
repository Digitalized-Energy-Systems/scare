{
  "$comment": [
    "Large noise-averaged aggregate (needs the run_local batch fix to exceed 36",
    "tasks). 3 arms x 40 reps = 120 tasks. default vs coord@0.03 vs coord@0.05.",
    "Read aggregate mean+/-std and clean-rate; the sim is nondeterministic so only",
    "many-rep aggregates are trustworthy."
  ],
  "name": "vvw_aggregate_big",
  "out_root": "experiment/_runs/eval",
  "simulation_duration_s": 30.0,
  "task_timeout_s": 600.0,
  "failure_delay_s_max": 2.0,
  "write_timeseries": false,
  "write_trajectories": true,
  "timestamp_dir": true,
  "defaults": { "runs_per_grid": 40, "failure_lambda": 0.5, "max_failures": 1 },
  "experiments": [
    {
      "name": "aggregate_big",
      "grids": ["simbench_lv_small"],
      "n_seeds": 40,
      "variants": ["scare"],
      "ablations": [
        {},
        { "enable_vvw_coordination": true, "enable_qv_auction_coordination": true, "qv_dvdq_prior": 0.03 },
        { "enable_vvw_coordination": true, "enable_qv_auction_coordination": true, "qv_dvdq_prior": 0.05 }
      ],
      "scenarios": [
        { "kind": "pv_peak", "gen_scale": 1.5, "load_scale": 0.4, "slack_vm_pu": 1.04, "priority_assignment": "skewed" }
      ]
    }
  ],
  "slurm": { "partition": "rosa_express.p", "time": "02:00:00", "mem": "16G", "cpus": 1, "max_concurrent": 64 }
}
