{
  "$comment": [
    "Hebbian-on vs hebbian-off head-to-head (post-fix).",
    "Single seed, identical scenario, only difference is enable_hebbian_formation."
  ],
  "name": "hebbian_on_off",
  "out_root": "experiment/_runs/eval",
  "simulation_duration_s": 30.0,
  "task_timeout_s": 1800.0,
  "failure_delay_s_max": 2.0,
  "write_timeseries": false,
  "timestamp_dir": true,
  "defaults": {
    "runs_per_grid": 1,
    "failure_lambda": 0.6,
    "max_failures": 2
  },
  "experiments": [
    {
      "name": "hebbian_on_off",
      "grids": ["simbench_lv_cp_heavy"],
      "n_seeds": 1,
      "variants": ["scare"],
      "ablations": [
        {"enable_hebbian_formation": true, "hebbian_warmup_s": 4.0, "hebbian_threshold": 0.15},
        {"enable_hebbian_formation": false, "hebbian_warmup_s": 4.0}
      ],
      "scenarios": [
        {"kind": "clean", "slack_budget_pct": 0.45}
      ]
    }
  ]
}
