{
  "$comment": "Tight-deficit quartet: simbench_lv with 6 concentrated failures and slack budget 0.15 (15% of nominal demand). Supply will be well below demand — exercises the L2 ADMM waterfall + per-actor allocation path. All four variants on identical (seed, scenario, failures).",
  "name": "deficit_quartet",
  "out_root": "experiment/_runs/eval",
  "simulation_duration_s": 30.0,
  "task_timeout_s": 600.0,
  "failure_delay_s_max": 1.0,
  "write_timeseries": true,
  "timestamp_dir": true,
  "defaults": {
    "runs_per_grid": 1,
    "failure_lambda": 1.5,
    "max_failures": 6
  },
  "experiments": [
    {
      "name": "deficit",
      "grids": ["simbench_lv"],
      "n_seeds": 1,
      "variants": ["scare", "single_level", "component_level", "oracle"],
      "scenarios": [
        {
          "kind": "clean",
          "failure_type": "concentrated",
          "n_failures": 6,
          "priority_assignment": "skewed",
          "slack_budget_pct": 0.15
        }
      ]
    }
  ]
}
