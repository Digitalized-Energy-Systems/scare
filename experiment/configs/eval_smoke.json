{
  "$comment": [
    "Minimal smoke test for the eval_full pipeline.",
    "One task per new code path so the harness can be validated in ~30 min wallclock.",
    "Use this to verify eval_full will actually run before submitting the 985-task campaign."
  ],
  "name": "eval_smoke",
  "out_root": "experiment/_runs/eval",
  "simulation_duration_s": 5.0,
  "task_timeout_s": 2400.0,
  "failure_delay_s_max": 2.0,
  "write_timeseries": true,
  "timestamp_dir": true,

  "defaults": {"runs_per_grid": 1, "failure_lambda": 0.6, "max_failures": 3},

  "experiments": [
    {
      "name": "functional_baseline",
      "grids": ["simbench_lv_constrained_45"],
      "n_seeds": 1,
      "variants": ["scare"]
    },
    {
      "name": "variant_comparison",
      "grids": ["simbench_lv_constrained_45"],
      "n_seeds": 1,
      "variants": ["scare", "single_level", "oracle"]
    },
    {
      "name": "ablation",
      "grids": ["simbench_lv_constrained_45"],
      "n_seeds": 1,
      "variants": ["scare"],
      "ablations": [{}, {"enable_holonic": false, "enable_cp_admm": false}]
    },
    {
      "name": "robustness_packet_loss",
      "grids": ["simbench_lv_constrained_45"],
      "n_seeds": 1,
      "variants": ["scare"],
      "sweeps": [{"comms_packet_loss_pct": 10.0}]
    },
    {
      "name": "cold_day_stress",
      "grids": ["simbench_lv_constrained_45"],
      "n_seeds": 1,
      "variants": ["scare"],
      "scenarios": [{"kind": "cold_day", "supply_t_k": 343.15, "heat_load_scale": 1.5}]
    },
    {
      "name": "generator_failure",
      "grids": ["simbench_lv_constrained_45"],
      "n_seeds": 1,
      "variants": ["scare"],
      "scenarios": [
        {"kind": "clean", "failure_type": "generator"},
        {"kind": "clean", "failure_type": "mixed", "generator_share": 0.5}
      ]
    },
    {
      "name": "scaling",
      "grids": [
        "simbench_lv_small_constrained_45",
        "simbench_lv_medium_constrained_45"
      ],
      "n_seeds": 1,
      "variants": ["scare", "oracle"]
    },
    {
      "name": "reconfiguration",
      "grids": ["simbench_lv_reconfig"],
      "n_seeds": 1,
      "variants": ["scare"],
      "scenarios": [{"kind": "clean", "failure_type": "branch", "max_failures": 1}]
    },
    {
      "name": "cooldown_sweep",
      "grids": ["simbench_lv_constrained_45"],
      "n_seeds": 1,
      "sweeps": [{"cooldown_s": 0.1}]
    }
  ],

  "slurm": {
    "partition": "rosa.p",
    "time": "00:45:00",
    "mem": "4G",
    "cpus": 1,
    "max_concurrent": 16,
    "aggregate": true
  }
}
