{
  "$comment": "Minimal smoke for the line_stress pillar only.  Uses the small ~15-bus simbench LV grid so the LP solves in seconds instead of minutes \u2014 the large constrained_45 hits the GEKKO string-length limit and never produces meaningful loading_percent values within the smoke wallclock budget.",
  "name": "line_stress_smoke",
  "out_root": "experiment/_runs/eval",
  "simulation_duration_s": 8.0,
  "task_timeout_s": 1800.0,
  "failure_delay_s_max": 1.0,
  "write_timeseries": true,
  "timestamp_dir": true,
  "defaults": {
    "runs_per_grid": 1,
    "failure_lambda": 1.5,
    "max_failures": 1
  },
  "experiments": [
    {
      "name": "line_stress",
      "grids": [
        "simbench_lv_small"
      ],
      "n_seeds": 1,
      "variants": [
        "scare"
      ],
      "ablations": [
        {},
        {
          "enable_line_loading_constraint": false
        },
        {
          "enable_reconfig_feasibility_ranking": false
        }
      ],
      "scenarios": [
        {
          "kind": "line_stress",
          "load_scale": 1.8,
          "ampacity_scale": 0.5,
          "max_failures": 1,
          "priority_assignment": "skewed",
          "slack_budget_pct": 0.45
        }
      ]
    }
  ]
}
