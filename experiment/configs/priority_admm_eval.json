{
  "$comment": [
    "End-to-end validation of Package C (tier-stratified holon ADMM).",
    "Replays the modularity_tuning scenario that previously failed",
    "priority_invariant in 3/4 modularity runs.  Expected outcome:",
    "  - tier_stratified=True  : priority_invariant passes",
    "  - tier_stratified=False : same as previous modularity_tuning",
    "                            (priority inversion observed)",
    "Both methods compared on label_propagation AND modularity partitions",
    "to verify the fix isn't partition-specific."
  ],
  "name": "priority_admm_eval",
  "out_root": "experiment/_runs/eval",
  "simulation_duration_s": 30.0,
  "task_timeout_s": 1800.0,
  "failure_delay_s_max": 2.0,
  "write_timeseries": false,
  "timestamp_dir": true,
  "defaults": {
    "runs_per_grid": 1,
    "failure_lambda": 1.5,
    "max_failures": 4
  },
  "experiments": [
    {
      "name": "tier_stratified_admm",
      "grids": ["simbench_lv_cp_heavy"],
      "n_seeds": 1,
      "variants": ["scare"],
      "ablations": [
        {
          "community_partition_method": "label_propagation",
          "enable_tier_stratified_holon_admm": false,
          "hebbian_warmup_s": 4.0
        },
        {
          "community_partition_method": "label_propagation",
          "enable_tier_stratified_holon_admm": true,
          "hebbian_warmup_s": 4.0
        },
        {
          "community_partition_method": "modularity",
          "enable_tier_stratified_holon_admm": false,
          "hebbian_warmup_s": 4.0
        },
        {
          "community_partition_method": "modularity",
          "enable_tier_stratified_holon_admm": true,
          "hebbian_warmup_s": 4.0
        }
      ],
      "scenarios": [
        {
          "kind": "line_stress",
          "load_scale": 1.8,
          "ampacity_scale": 0.5,
          "slack_budget_pct": 0.45
        }
      ]
    }
  ]
}
